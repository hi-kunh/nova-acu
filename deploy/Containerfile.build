#
# acud를 빌드하기 위한 이미지. **타깃 보드와 같은 배포판/아키텍처**여야 한다.
#
# 왜 이렇게 하나:
#   개발 PC는 Ubuntu 26.04 / glibc 2.43, 보드는 Debian 11 bullseye / glibc 2.31 이다.
#   개발 PC에서 aarch64 크로스 컴파일러로 그냥 빌드하면 glibc 2.43 심볼을 참조해
#   보드에서 "version GLIBC_2.3x not found"로 실행되지 않는다.
#   타깃과 같은 이미지 안에서 빌드하면 그 문제가 애초에 생기지 않는다.
#
FROM docker.io/library/debian:bullseye

#
# bullseye는 EOL이다. 보드에서 확인한 것과 같은 문제가 여기서도 그대로 난다:
#   - bullseye-security: Release는 살아 있으나 풀의 .deb가 삭제됨(404)
#   - apt는 모든 candidate를 security 버전으로 잡아 설치 자체가 막힌다
# 그래서 security 저장소를 비활성화해 bullseye main 버전으로 떨어뜨린다.
# (자세한 경위는 README "apt 문제 - 앞선 분석에서 두 가지가 틀렸다" 참고)
#
#
# 여기에 더해, 베이스 이미지에는 이미 security 버전 libc6(2.31-13+deb11u14)이 들어 있다.
# security를 끄면 남는 것은 bullseye main의 u11뿐이라 libc6-dev(u11)와 버전이 어긋나
# "Depends: libc6 (= ...u11) but ...u14 is to be installed"로 설치가 막힌다.
#
# 그래서 bullseye main을 우선순위 1001로 고정해 **다운그레이드를 허용**한다.
# (apt는 1000을 넘는 우선순위에서만 다운그레이드를 한다)
#
# u11로 맞추는 것이 옳은 이유: 보드에 실제로 깔려 있는 것이 u11이다.
# 그리고 glibc는 심볼 버전을 쓰기 때문에 낮은 버전으로 빌드한 바이너리는 높은 버전에서도 돈다.
#
RUN set -eux; \
    sed -i '/bullseye-security/d; /bullseye-backports/d' /etc/apt/sources.list; \
    echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99no-check-valid-until; \
    printf 'Package: *\nPin: release n=bullseye\nPin-Priority: 1001\n' \
        > /etc/apt/preferences.d/bullseye-main; \
    apt-get update; \
    apt-get install -y --no-install-recommends --allow-downgrades \
        gcc make libc6-dev libsqlite3-dev libcjson-dev binutils; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /src
